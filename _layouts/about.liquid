---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {% if page.profile.image_compare %}
            {% assign profile_image_compare_path = page.profile.image_compare | prepend: 'assets/img/' %}
            <img-comparison-slider class="about-profile-slider" value="20" style="opacity: 0;">
              {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image cache_bust=true slot="first" %}
              {% include figure.liquid path=profile_image_compare_path class=profile_image_class sizes=sizes alt=page.profile.image_compare slot="second" %}
            </img-comparison-slider>
          {% else %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% raw %}
    <br />
    <script type="text/javascript" id="clstr_globe" src="//clustrmaps.com/globe.js?d=IYu8iNH6bZ7whJUi54OooLM7iOqBUPxR_nqajHvb2CI&w=400"></script>
    <br />
    {% endraw %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}


    <script>
      const segmentText = (text) => {
        if (typeof Intl !== 'undefined' && Intl.Segmenter) {
          const segmenter = new Intl.Segmenter(undefined, { granularity: 'grapheme' });
          return Array.from(segmenter.segment(text), (s) => s.segment);
        }
        return Array.from(text);
      };

      const baseDelayMs = 400;
      const stepDelayMs = 40;

      document.querySelectorAll('.post article > .clearfix p strong').forEach((el) => {
        const parts = segmentText(el.textContent || '');
        const fragment = document.createDocumentFragment();
        const spans = [];
        let local = 0;

        parts.forEach((part) => {
          const span = document.createElement('span');
          span.style.setProperty('--ci', String(local++));
          span.textContent = part;
          fragment.appendChild(span);
          spans.push(span);
        });

        el.replaceChildren(fragment);

        spans.forEach((span, index) => {
          window.setTimeout(() => {
            span.classList.add('is-bold');
          }, baseDelayMs + index * stepDelayMs);
        });

        // Fallback: force completion in case timers are throttled.
        window.setTimeout(
          () => spans.forEach((span) => span.classList.add('is-bold')),
          baseDelayMs + spans.length * stepDelayMs + 150
        );
      });

      const initComparisonSliders = () => {
        document.querySelectorAll('img-comparison-slider.about-profile-slider').forEach((slider) => {
          const raw = slider.getAttribute('value') || '50';
          const parsed = Number.parseFloat(raw);

          if (!Number.isNaN(parsed)) {
            const clamped = Math.max(0, Math.min(100, parsed));
            slider.value = clamped;
            slider.setAttribute('value', String(clamped));
          }

          // Give the web component a brief settle window before revealing,
          // so the default center position is never visible.
          window.setTimeout(() => {
            slider.style.opacity = '1';
          }, 220);
        });
      };

      if (window.customElements && window.customElements.whenDefined) {
        window.customElements.whenDefined('img-comparison-slider').then(() => {
          requestAnimationFrame(initComparisonSliders);
        });
      } else {
        initComparisonSliders();
      }

    </script>
  </article>
</div>
