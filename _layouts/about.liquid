---
layout: default
---
<div class="post">
  <!-- Masthead — two hairline rules, no fake metadata -->
  <div class="masthead">
    <div class="masthead-rule"></div>
    <div class="masthead-rule thin"></div>
  </div>

  <header class="post-header">
    <h1 class="post-title" style="visibility: hidden;">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <script>
      (function () {
        const titleEl = document.currentScript.previousElementSibling;
        if (!titleEl || !titleEl.classList.contains('post-title')) return;

        const segment = (text) => {
          if (typeof Intl !== 'undefined' && Intl.Segmenter) {
            const seg = new Intl.Segmenter(undefined, { granularity: 'grapheme' });
            return Array.from(seg.segment(text), (s) => s.segment);
          }
          return Array.from(text);
        };

        let counter = 0;
        // Normalize like the browser would: collapse runs of whitespace to a
        // single space so Liquid indentation between tags doesn't produce
        // stray nbsp characters in the title.
        const wrapTextNode = (node) => {
          const collapsed = node.nodeValue.replace(/\s+/g, ' ');
          if (collapsed === ' ' || collapsed === '') {
            // Pure-whitespace node between elements — keep one space if there's
            // visible content on both sides; otherwise drop it.
            const prev = node.previousSibling;
            const next = node.nextSibling;
            if (prev && next) {
              const span = document.createElement('span');
              span.className = 'post-title-char';
              span.style.setProperty('--ci', String(counter++));
              span.innerHTML = '&nbsp;';
              node.parentNode.replaceChild(span, node);
            } else {
              node.parentNode.removeChild(node);
            }
            return;
          }
          const parts = segment(collapsed);
          const frag = document.createDocumentFragment();
          parts.forEach((part) => {
            const span = document.createElement('span');
            span.className = 'post-title-char';
            span.style.setProperty('--ci', String(counter++));
            if (part === ' ') {
              span.innerHTML = '&nbsp;';
            } else {
              span.textContent = part;
            }
            frag.appendChild(span);
          });
          node.parentNode.replaceChild(frag, node);
        };

        const walk = (el) => {
          const children = Array.from(el.childNodes);
          children.forEach((child) => {
            if (child.nodeType === Node.TEXT_NODE) {
              if (child.nodeValue && child.nodeValue.length) {
                wrapTextNode(child);
              }
            } else if (child.nodeType === Node.ELEMENT_NODE) {
              walk(child);
            }
          });
        };

        walk(titleEl);
        titleEl.style.visibility = 'visible';
      })();
    </script>
    <p class="desc">— {{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {% if page.profile.image_compare %}
            {% assign profile_image_compare_path = page.profile.image_compare | prepend: 'assets/img/' %}
            <img-comparison-slider class="about-profile-slider" value="20" style="opacity: 0;">
              {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image cache_bust=true slot="first" %}
              {% include figure.liquid path=profile_image_compare_path class=profile_image_class sizes=sizes alt=page.profile.image_compare slot="second" %}
            </img-comparison-slider>
          {% else %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% raw %}
    <br />
    <script type="text/javascript" id="clstr_globe" src="//clustrmaps.com/globe.js?d=IYu8iNH6bZ7whJUi54OooLM7iOqBUPxR_nqajHvb2CI&w=400"></script>
    <br />
    {% endraw %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}

    <script>
      const segmentText = (text) => {
        if (typeof Intl !== 'undefined' && Intl.Segmenter) {
          const segmenter = new Intl.Segmenter(undefined, { granularity: 'grapheme' });
          return Array.from(segmenter.segment(text), (s) => s.segment);
        }
        return Array.from(text);
      };

      const baseDelayMs = 220;
      const stepDelayMs = 40;
      const aboutStrongAnimSeenKey = 'about-strong-bold-seen';
      const splashMaxDurationMs = 4500;

      const shouldRunAboutStrongAnimation = () => {
        try {
          if (window.sessionStorage.getItem(aboutStrongAnimSeenKey) === '1') {
            return false;
          }
          window.sessionStorage.setItem(aboutStrongAnimSeenKey, '1');
          return true;
        } catch (e) {
          // If storage is unavailable, keep the current behavior.
          return true;
        }
      };

      const animateAboutStrongText = () => {
        document.querySelectorAll('.post article > .clearfix p strong').forEach((el) => {
          const parts = segmentText(el.textContent || '');
          const fragment = document.createDocumentFragment();
          const spans = [];
          let local = 0;

          parts.forEach((part) => {
            const span = document.createElement('span');
            span.style.setProperty('--ci', String(local++));
            span.textContent = part;
            fragment.appendChild(span);
            spans.push(span);
          });

          el.replaceChildren(fragment);

          spans.forEach((span, index) => {
            window.setTimeout(
              () => {
                span.classList.add('is-bold');
              },
              baseDelayMs + index * stepDelayMs
            );
          });

          // Fallback: force completion in case timers are throttled.
          window.setTimeout(() => spans.forEach((span) => span.classList.add('is-bold')), baseDelayMs + spans.length * stepDelayMs + 150);
        });
      };

      const runAfterSplash = (fn) => {
        const splash = document.getElementById('site-splash');
        if (!splash) {
          fn();
          return;
        }

        let finished = false;
        let observer;

        const finish = () => {
          if (finished) return;
          finished = true;
          if (observer) observer.disconnect();
          fn();
        };

        observer = new MutationObserver(() => {
          if (!document.getElementById('site-splash')) {
            finish();
          }
        });

        observer.observe(document.body, { childList: true });

        splash.addEventListener(
          'transitionend',
          () => {
            if (splash.style.opacity === '0' || !document.getElementById('site-splash')) {
              finish();
            }
          },
          { once: true }
        );

        window.setTimeout(finish, splashMaxDurationMs);
      };

      if (shouldRunAboutStrongAnimation()) {
        runAfterSplash(animateAboutStrongText);
      }

      const initComparisonSliders = () => {
        const aboutSliderWarmKey = 'about-slider-warm';
        let isWarmVisit = false;

        try {
          isWarmVisit = window.sessionStorage.getItem(aboutSliderWarmKey) === '1';
        } catch (e) {
          isWarmVisit = false;
        }

        document.querySelectorAll('img-comparison-slider.about-profile-slider').forEach((slider) => {
          const raw = slider.getAttribute('value') || '50';
          const parsed = Number.parseFloat(raw);

          if (!Number.isNaN(parsed)) {
            const clamped = Math.max(0, Math.min(100, parsed));
            slider.value = clamped;
            slider.setAttribute('value', String(clamped));
          }

          if (isWarmVisit) {
            slider.style.opacity = '1';
          } else {
            // Give the web component a brief settle window before revealing,
            // so the default center position is never visible on cold load.
            window.setTimeout(() => {
              slider.style.opacity = '1';
            }, 220);
          }
        });

        try {
          window.sessionStorage.setItem(aboutSliderWarmKey, '1');
        } catch (e) {
          // Ignore storage failures.
        }
      };

      if (window.customElements && window.customElements.whenDefined) {
        window.customElements.whenDefined('img-comparison-slider').then(() => {
          requestAnimationFrame(initComparisonSliders);
        });
      } else {
        initComparisonSliders();
      }
    </script>
  </article>
</div>
